# ─── Contact form ─────────────────────────────────────────────────────────────
# The API Gateway URL output by `sam deploy` (see lambda/template.yaml).
# Set this as an environment variable in CodeBuild AND in .env.local for local dev.
NEXT_PUBLIC_CONTACT_API_URL=https://XXXXXXXXXX.execute-api.us-east-1.amazonaws.com/Prod/contact

# ─── Cloudflare Turnstile ─────────────────────────────────────────────────────
# Public site key — safe to commit; get it from dash.cloudflare.com → Turnstile
# Leave empty to disable the CAPTCHA widget (honeypot still active).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# ─── (server-side only — never prefix with NEXT_PUBLIC_) ──────────────────────
# These go in Lambda env vars via SAM, NOT in the Next.js build.
# TURNSTILE_SECRET_KEY=...   ← in SAM template / SSM Parameter Store
# FROM_EMAIL=noreply@tonidocs.com
# TO_EMAIL=toniwallace97@outlook.com
